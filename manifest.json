{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.4.3",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": ["storage", "declarativeNetRequest"],
  "background": {
    "service_worker": "src/background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube-page-ads",
        "enabled": false,
        "path": "rules/page-ads.json"
      }
    ]
  },
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"],
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    },
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "css": ["src/content/youtubi.css"],
      "js": [
        "src/shared/i18n.js",
        "src/shared/settings.js",
        "src/content/danmakuLayer.js",
        "src/content/commentSource.js",
        "src/content/youtubeInnertube.js",
        "src/content/youtubeCommentApiSource.js",
        "src/content/youtubeLiveChatSource.js",
        "src/content/adWatcher.js",
        "src/content/adSpeedup.js",
        "src/content/timelineScheduler.js",
        "src/content/realtimeScheduler.js",
        "src/content/danmakuPlaybackController.js",
        "src/content/youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["src/content/adblockBridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["src/content/adblockMain.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
